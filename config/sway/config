# Sway config — ported from i3 config
# Lives in ~/src/dotfiles/config/sway/config, symlinked to ~/.config/sway/config
# i3 config stays untouched at ~/.config/i3/config (symlinked to dotfiles too).
#
# Key differences from the i3 config:
# - output configuration uses sway native `output` instead of xrandr
# - wallpaper uses swaybg instead of feh
# - lock uses swaylock instead of xss-lock
# - bar uses waybar instead of polybar
# - no compositor needed (sway IS the compositor)
# - `font pango:` becomes `font`
# - `bindsym` stays the same; `exec` stays the same
# - `for_window [class="..."]` becomes `for_window [app_id="..."]` for Wayland apps
#   but [class="..."] still works for XWayland apps via xwayland criteria

set $mod Mod4
set $term wezterm
set $menu rofi -show drun

# Font
font monospace 11

# Window appearance / gaps
default_border pixel 2
gaps inner 10
gaps outer 0

# Mouse behavior
floating_modifier $mod normal
focus_follows_mouse yes
tiling_drag modifier

# Output configuration (replaces xrandr)
# HDMI-A-1: 1920x1080 external (Samsung LS32B30), left of eDP-1
# eDP-1: 2880x1800 laptop panel, primary (scale 2 = 1440x900 logical)
output HDMI-A-1 resolution 1920x1080 position 0,0
output eDP-1 resolution 2880x1800 scale 2 position 1920,0

# Wallpaper (replaces feh)
exec swaybg -o "*" -i ~/.config/wallpapers/pixel-frontier-sunset-stockcake-1680x1050-focal.jpg -m fill

# Idle lock (replaces xss-lock)
exec swayidle -w \
    timeout 300 'swaylock -f -c 1a0f0a' \
    timeout 600 'swaymsg output "*" power off' \
    resume 'swaymsg output "*" power on' \
    before-sleep 'swaylock -f -c 1a0f0a'

# Bar (replaces polybar)
exec waybar

# Autostart / desktop integration
# Force libadwaita dark mode (same as i3 config)
exec sh -c 'export ADW_DEBUG_COLOR_SCHEME=force-dark; dbus-update-activation-environment --systemd ADW_DEBUG_COLOR_SCHEME WAYLAND_DISPLAY XDG_CURRENT_DESKTOP 2>/dev/null; systemctl --user import-environment ADW_DEBUG_COLOR_SCHEME WAYLAND_DISPLAY XDG_CURRENT_DESKTOP 2>/dev/null || true'
# PolKit agent for GUI auth prompts (1Password system auth etc.)
exec_always sh -c 'pgrep -f "polkit-gnome-authentication-agent-1" >/dev/null && exit 0; p=/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1; [ -x "$p" ] && exec "$p"; true'
# Network manager applet
exec nm-applet --indicator
# Bluetooth applet
exec blueman-applet
# XDG autostart (1Password, sgnconnect, etc. — same as i3's dex)
exec dex --autostart --environment sway
# Screenshots use grim+slurp (Wayland-native); flameshot is X11-only

# Media / system keys (PipeWire/WirePlumber — same as i3)
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 10%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Screenshots (grim+slurp+swappy — Wayland-native, replaces flameshot)
# Print: select region, annotate in swappy, then copy/save from swappy
bindsym Print exec grim -g "$(slurp)" - | swappy -f -
# Mod+Print: full screen, annotate in swappy
bindsym $mod+Print exec grim - | swappy -f -
# Shift+Print: select region, save directly to ~/Pictures/Screenshots (no annotation)
bindsym Shift+Print exec grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png
# Mod+Shift+s: same as Print (region select + annotation)
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | swappy -f -
# F13: full screen, save directly to ~/Pictures/Screenshots (no annotation)
bindsym F13 exec grim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png

# Launchers
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+d exec rofi -show run
bindsym $mod+Tab exec rofi -show window
bindsym $mod+Shift+a exec ~/.config/i3/scripts/bluetooth-audio-picker.sh
bindsym $mod+Shift+p exec dmenu_run

# Window controls
bindsym $mod+Shift+q kill
bindsym $mod+q exec swaylock -f -c 1a0f0a

# Focus: vim-style h/j/k/l plus arrow keys
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Move workspace between outputs
bindsym $mod+Ctrl+h move workspace to output left
bindsym $mod+Ctrl+l move workspace to output right
bindsym $mod+Ctrl+Left move workspace to output left
bindsym $mod+Ctrl+Right move workspace to output right

# Splits / layouts
bindsym $mod+g split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+comma layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move window to workspace and follow it
bindsym $mod+Shift+1 move container to workspace number $ws1; workspace number $ws1; focus
bindsym $mod+Shift+2 move container to workspace number $ws2; workspace number $ws2; focus
bindsym $mod+Shift+3 move container to workspace number $ws3; workspace number $ws3; focus
bindsym $mod+Shift+4 move container to workspace number $ws4; workspace number $ws4; focus
bindsym $mod+Shift+5 move container to workspace number $ws5; workspace number $ws5; focus
bindsym $mod+Shift+6 move container to workspace number $ws6; workspace number $ws6; focus
bindsym $mod+Shift+7 move container to workspace number $ws7; workspace number $ws7; focus
bindsym $mod+Shift+8 move container to workspace number $ws8; workspace number $ws8; focus
bindsym $mod+Shift+9 move container to workspace number $ws9; workspace number $ws9; focus
bindsym $mod+Shift+0 move container to workspace number $ws10; workspace number $ws10; focus

# Reload / exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway? This will end your Wayland session.' -B 'Yes, exit Sway' 'swaymsg exit'

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym l resize grow width 10 px
    bindsym k resize shrink height 10 px
    bindsym j resize grow height 10 px

    bindsym Left resize shrink width 10 px
    bindsym Right resize grow width 10 px
    bindsym Up resize shrink height 10 px
    bindsym Down resize grow height 10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Theme: Yendo Cowboy palette (same colors as i3 config)
set $bg          #1a0f0a
set $bg_darker   #0d0704
set $bg_mid      #2d1810
set $bg_tertiary #3d1e0f
set $fg          #fff5e1
set $primary     #e87530
set $accent      #f5a623
set $border      #c4522a
set $ok          #4caf50
set $error       #ef5350
set $dim         #8b4513
set $muted       #a0522d

# Colors                border      backgr       text       indicator   child_border
client.focused          $primary    $primary     $bg        $accent     $primary
client.focused_inactive $muted      $bg_mid      $fg        $border     $muted
client.unfocused        $dim        $bg_darker   $muted     $border     $dim
client.urgent           $error      $error       $bg        $error      $error
client.placeholder      $bg_mid     $bg_mid      $fg        $accent     $bg_mid
client.background       $bg

# Floating rules
for_window [app_id="rofi"] floating enable, border none
for_window [class="Rofi"] floating enable, border none
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
