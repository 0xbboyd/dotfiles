#!/bin/bash
# mise-updates-check: Poll mise for outdated tools and emit waybar JSON.
#
# Uses `mise outdated` which respects version constraints in mise.toml.
# Tools pinned to "latest" get checked against the newest available.
# Tools pinned to a major (e.g. "24") only show updates within that range.
#
# Output: waybar custom module JSON
# State: ~/.local/state/mise-updates/dismissed-<hash>

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mise-updates"
mkdir -p "$STATE_DIR"

export PATH="$HOME/.local/bin:$PATH"
export MISE_MINIMUM_RELEASE_AGE=0

# mise outdated respects version constraints — only shows updates
# that `mise up` would actually install.
raw=$(mise outdated 2>/dev/null || true)

# Filter out mise's own status lines (not tool entries)
updates=()
hash_input=""

while IFS= read -r line; do
    [[ -z $line ]] && continue
    # Skip mise's own messages like "All tools are up to date"
    [[ $line == "mise "* ]] && continue
    # Skip blank/whitespace lines
    [[ $line =~ ^[[:space:]]*$ ]] && continue
    # Parse: "tool  requested  current  latest  source"
    tool=$(echo "$line" | awk '{print $1}')
    current=$(echo "$line" | awk '{print $3}')
    latest=$(echo "$line" | awk '{print $4}')
    [[ -z $tool || -z $latest ]] && continue
    updates+=("${tool}: ${current} -> ${latest}")
    hash_input+="${tool}:${latest} "
done <<< "$raw"

count=${#updates[@]}

if (( count == 0 )); then
    printf '{"text":"","class":"mise-updates-empty"}\n'
    exit 0
fi

update_hash=$(echo -n "$hash_input" | md5sum | awk '{print $1}')
dismiss_file="$STATE_DIR/dismissed-$update_hash"

if [[ -f $dismiss_file ]]; then
    printf '{"text":"","class":"mise-updates-dismissed"}\n'
    exit 0
fi

tooltip=$(printf '%s\n' "${updates[@]}")
tooltip_escaped=$(python3 -c "import json,sys; print(json.dumps(sys.stdin.read().strip())[1:-1])" <<< "$tooltip")

icon="\uf021"
if (( count == 1 )); then
    text=" ${icon} 1 update "
else
    text=" ${icon} ${count} updates "
fi

printf '{"text":"%s","tooltip":"%s","class":"mise-updates","percentage":%d}\n' \
    "$text" "$tooltip_escaped" "$count"
