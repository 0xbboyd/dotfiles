#!/bin/bash
# mise-updates-dismiss: Right-click handler for the waybar mise module.
# Uses mise outdated (same as the checker) so hashes match.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mise-updates"
mkdir -p "$STATE_DIR"

export PATH="$HOME/.local/bin:$PATH"
export MISE_MINIMUM_RELEASE_AGE=0

raw=$(mise outdated 2>/dev/null || true)

hash_input=""

while IFS= read -r line; do
    [[ -z $line ]] && continue
    [[ $line == "mise "* ]] && continue
    [[ $line =~ ^[[:space:]]*$ ]] && continue
    tool=$(echo "$line" | awk '{print $1}')
    latest=$(echo "$line" | awk '{print $4}')
    [[ -z $tool || -z $latest ]] && continue
    hash_input+="${tool}:${latest} "
done <<< "$raw"

if [[ -z $hash_input ]]; then
    exit 0
fi

update_hash=$(echo -n "$hash_input" | md5sum | awk '{print $1}')
touch "$STATE_DIR/dismissed-$update_hash"

pkill -RTMIN+1 waybar 2>/dev/null || true
