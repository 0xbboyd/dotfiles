{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/left-cap",
        "network",
        "custom/sep-cpu",
        "cpu",
        "custom/sep-memory",
        "memory",
        "custom/sep-pulseaudio",
        "pulseaudio",
        "custom/sep-battery",
        "battery",
        "custom/sep-date",
        "clock",
        "custom/sep-mise",
        "custom/mise-updates",
        "custom/sep-bumps",
        "custom/mise-bumps",
        "tray"
    ],
    "sway/workspaces": {
        "format": " {name} ",
        "format-icons": {
            "focused": "",
            "default": ""
        }
    },
    "sway/mode": {
        "format": " {} ",
        "tooltip": false
    },
    "clock": {
        "format": " {:%a %b %d %I:%M %p} ",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": " CPU {usage}% ",
        "interval": 2
    },
    "memory": {
        "format": " MEM {percentage}% ",
        "interval": 5
    },
    "pulseaudio": {
        "format": " VOL {volume}% ",
        "format-muted": " VOL muted ",
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },
    "battery": {
        "bat": "BAT0",
        "adapter": "AC",
        "interval": 10,
        "format": " BAT {capacity}% ",
        "format-charging": " BAT {capacity}%+ ",
        "format-full": " BAT full ",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "network": {
        "interface": "wlp0s20f3",
        "interval": 5,
        "format-wifi": " WLAN {essid} ",
        "format-disconnected": " WLAN down ",
        "tooltip-format": "{ifname} {ipaddr}"
    },
    "tray": {
        "spacing": 4
    },
    "custom/left-cap": {
        "format": "\ue0b2"
    },
    "custom/sep-cpu": {
        "format": "\ue0b2"
    },
    "custom/sep-memory": {
        "format": "\ue0b2"
    },
    "custom/sep-pulseaudio": {
        "format": "\ue0b2"
    },
    "custom/sep-battery": {
        "format": "\ue0b2"
    },
    "custom/sep-date": {
        "format": ""
    },
    "custom/sep-mise": {
        "format": ""
    },
    "custom/mise-updates": {
        "exec": "~/.local/bin/mise-updates-check",
        "exec-interval": 21600,
        "return-type": "json",
        "format": "{}",
        "on-click": "MISE_MINIMUM_RELEASE_AGE=0 mise up -y && pkill -RTMIN+1 waybar",
        "on-click-right": "~/.local/bin/mise-updates-dismiss",
        "tooltip": true
    },
    "custom/sep-bumps": {
        "format": ""
    },
    "custom/mise-bumps": {
        "exec": "~/.local/bin/mise-bumps-check",
        "exec-interval": 21600,
        "return-type": "json",
        "format": "{}",
        "on-click": "MISE_MINIMUM_RELEASE_AGE=0 mise up --bump -y && pkill -RTMIN+1 waybar",
        "on-click-right": "~/.local/bin/mise-bumps-dismiss",
        "tooltip": true
    }
}
