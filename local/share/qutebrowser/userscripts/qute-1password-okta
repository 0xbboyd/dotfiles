#!/usr/bin/env python3
"""Fill Okta credentials from 1Password in qutebrowser.

Configured for Brendan's Yendo 1Password account:
  username: op://Employee/Okta/username
  password: op://Employee/Okta/password

No secret is written to disk or the clipboard. The password is held in process
memory and sent directly to the active qutebrowser page via QUTE_FIFO + jseval.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from urllib.parse import urlparse

USERNAME_REF = os.environ.get("QUTE_1P_OKTA_USERNAME_REF", "op://Employee/Okta/username")
PASSWORD_REF = os.environ.get("QUTE_1P_OKTA_PASSWORD_REF", "op://Employee/Okta/password")
ALLOWED_HOSTS = {
    "login.yendo.com",
    "yendo.okta.com",
    "yendo-admin.okta.com",
}


def qute_cmd(command: str) -> None:
    fifo = os.environ.get("QUTE_FIFO")
    if not fifo:
        raise SystemExit("QUTE_FIFO is not set; run this as a qutebrowser userscript")
    with open(fifo, "w", encoding="utf-8") as f:
        f.write(command.rstrip("\n") + "\n")


def qute_error(message: str) -> None:
    qute_cmd("message-error " + message.replace("\n", " "))


def op_read(ref: str) -> str:
    proc = subprocess.run(
        ["op", "read", ref],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or f"op read failed for {ref}")
    value = proc.stdout.rstrip("\n")
    if not value:
        raise RuntimeError(f"1Password returned an empty value for {ref}")
    return value


def main() -> int:
    url = os.environ.get("QUTE_URL", "")
    host = (urlparse(url).hostname or "").lower()
    if host not in ALLOWED_HOSTS:
        qute_error(f"Refusing to fill 1Password Okta credentials on non-Okta host: {host or 'unknown'}")
        return 2

    try:
        username = op_read(USERNAME_REF)
        password = op_read(PASSWORD_REF)
    except Exception as exc:
        qute_error(f"1Password Okta fill failed: {exc}")
        return 1

    js = r"""
(() => {
  const username = __USERNAME__;
  const password = __PASSWORD__;
  const visible = (el) => !!(el && el.offsetParent !== null && !el.disabled && !el.readOnly);
  const setValue = (el, value) => {
    el.focus();
    el.value = value;
    el.dispatchEvent(new Event('input', {bubbles: true}));
    el.dispatchEvent(new Event('change', {bubbles: true}));
  };
  const firstVisible = (selectors) => {
    for (const selector of selectors) {
      for (const el of document.querySelectorAll(selector)) {
        if (visible(el)) return el;
      }
    }
    return null;
  };
  const userEl = firstVisible([
    'input[name="identifier"]',
    'input[name="username"]',
    'input[name="login"]',
    'input#okta-signin-username',
    'input[type="email"]',
    'input[type="text"]'
  ]);
  const passEl = firstVisible([
    'input[name="credentials.passcode"]',
    'input[name="password"]',
    'input#okta-signin-password',
    'input[type="password"]'
  ]);
  if (userEl) setValue(userEl, username);
  if (passEl) setValue(passEl, password);
  return `1Password Okta fill: ${userEl ? 'username' : 'no username field'}, ${passEl ? 'password' : 'no password field'}`;
})()
""".replace("__USERNAME__", json.dumps(username)).replace("__PASSWORD__", json.dumps(password))

    # Run in the page's main JS world so React/Okta input handlers see events.
    qute_cmd("jseval --world main " + js)
    return 0


if __name__ == "__main__":
    sys.exit(main())
