  email = firemound@gmail.com

[core]

  excludesfile = ~/.gitignore_global
	autocrlf = input
	editor = nvim

[push]

  default = current

[alias]

  # status using the short format
  s = status -s

  # nice log
  l = log --all --graph --pretty=format:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

  # Remove merged branches
  cleanup= "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"

  # Find commits by source code
  fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"

  # Find commits by commit message
  fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"

  # verbose branch & remote info
  branches = branch -a
  remotes = remote -v 

  # Amend the currently staged files to the latest commit
  amend = commit --amend --reuse-message=HEAD
	open-mr = push -o merge_request.create

[color]

  ui = true

[color "branch"]

  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]

  meta = yellow bold
  frag = magenta bold # line info
  old = red # deletions
  new = green # additions

[color "status"]

  added = yellow
  changed = green
  untracked = cyan


[filter "media"]

  clean = git media clean %f
  smudge = git media smudge %f
  required = true

[git-up "fetch"]

  prune = true
  all = true

[git-up "bundler"]

  check = true

[pull]
	rebase = false
[init]
  defaultBranch = main

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

# --- Quality-of-life defaults ported from Omarchy ---

[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # More intuitive refs in diff output

[commit]
	verbose = true           # Include diff comment in commit message template

[column]
	ui = auto                # Output in columns when possible

[branch]
	sort = -committerdate    # Sort branches by most recent commit first

[tag]
	sort = -version:refname  # Sort version numbers as you would expect

[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically
